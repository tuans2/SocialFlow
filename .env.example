# SocialFlow Configuration

# ── AI Text Provider ──────────────────────────────────────────────────────────
# Choose which AI generates your content: ollama | openai | anthropic | gemini
# Default: ollama (free, local, no API key needed)
AI_PROVIDER=ollama

# Optional: Cloud AI API keys (only needed if AI_PROVIDER is not ollama)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# GEMINI_API_KEY=AIza-your-gemini-api-key-here

# ── HeyGen Video Generation ──────────────────────────────────────────────────
# Browser-based login (NOT API). Credentials encrypted locally.
# Set these OR add via SocialFlow dashboard: http://localhost:8000
HEYGEN_EMAIL=your-heygen-email@example.com
HEYGEN_PASSWORD=your-heygen-password

# ── Browser Mode ──────────────────────────────────────────────────────────────
# false = visible browser (recommended for first login, more reliable)
# true = headless/invisible browser (use after sessions are established)
HEADLESS=false

# ── Ollama (Local AI) ────────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ── Image Generation ────────────────────────────────────────────────────────
# Uses GPT Image 1.5 (replaces deprecated DALL-E 3, 75% cheaper)
# Requires OPENAI_API_KEY to be set above
IMAGE_MODEL=gpt-image-1.5
# Image quality — gpt-image-*: low | medium | high | auto  (dall-e-3: standard | hd)
# Leave empty to use the per-model default (high for gpt-image-*)
IMAGE_QUALITY=

# ── Zalo Official Account ────────────────────────────────────────────────────
# Get credentials from https://developers.zalo.me/
# App ID and Secret Key: from your Zalo app settings
# Refresh Token: obtained via OAuth flow (valid 3 months)
# ZALO_APP_ID=your-zalo-app-id
# ZALO_SECRET_KEY=your-zalo-secret-key
# ZALO_REFRESH_TOKEN=your-zalo-refresh-token

# ── Facebook Page publishing (Graph API — preferred over browser automation) ──
# With these set, SocialFlow publishes to the Page in one API request:
# caption + image together, no browser, no login checkpoint, no selectors.
# Leave empty to keep using Playwright on facebook.com.
# Run: python backend/facebook_graph_setup.py   to obtain the values.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v21.0
# Only needed while running facebook_graph_setup.py (from developers.facebook.com):
FB_APP_ID=
FB_APP_SECRET=

# Base URL the backend is reachable at. Used to build absolute media URLs
# returned by the upload endpoints (avatar photo / audio). Default suits local dev.
PUBLIC_BASE_URL=http://localhost:8000

# Cost per generated image, in USD. Optional and never guessed: leave it blank
# and assets.cost_usd stays NULL. Set it to make spend queryable per provider.
IMAGE_COST_USD=

# ── Video generation ─────────────────────────────────────────────────────
# Which backend to use. "veo" needs no new account: it runs on the same
# GEMINI_API_KEY as text generation.
DEFAULT_VIDEO_PROVIDER=veo

# Veo model + output settings. Leave blank for the defaults shown.
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p

# USD per second of generated video. Optional and never guessed — leave blank
# and cost_usd stays NULL. Check Google's current pricing page before setting.
VEO_COST_PER_SECOND=
